# Copy to .env and adjust as needed. Never commit .env.

# LiveKit (must match deployments/docker/livekit.yaml keys)
LIVEKIT_URL=ws://127.0.0.1:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=devsecret_ai_voice_platform_local_only

# voice-gateway HTTP listen address
VOICE_GATEWAY_ADDR=:8080

# Browser origin allowed by voice-gateway CORS (F2+)
VOICE_GATEWAY_CORS_ORIGIN=http://127.0.0.1:5173

# Deepgram streaming STT (Phase 2 — optional)
# Leave unset to disable STT; Phase 1 (tone) still works.
DEEPGRAM_API_KEY=
# DEEPGRAM_LISTEN_URL=wss://api.deepgram.com/v1/listen
# STT_SAMPLE_RATE=16000

# ai-orchestrator HTTP listen address (Phase 3)
AI_ORCHESTRATOR_ADDR=:8081

# LLM (Phase 3 — OpenAI-compatible endpoint; Gemini works out of the box)
# Leave LLM_API_KEY unset to run without LLM calls.
LLM_API_KEY=
# Default base URL targets Gemini's OpenAI-compatible API.
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# LLM_MODEL=gemini-3.6-flash
#
# Optional override for the support agent system prompt (defaults built in).
# AGENT_SYSTEM_PROMPT=
#
# OpenAI example:
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini

